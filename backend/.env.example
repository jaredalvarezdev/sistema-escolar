# ==========================================================
#  Variables de entorno - Sistema Escolar
#  1. Copie este archivo y renómbrelo a .env
#  2. Reemplace los valores de ejemplo por los reales
#  3. NUNCA suba el archivo .env al repositorio
# ==========================================================

# Cadena de conexión a MongoDB Atlas
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@clusterescolar.xxxxx.mongodb.net/

# Clave secreta para firmar los tokens JWT (mínimo 32 caracteres)
JWT_SECRET=reemplazar_por_una_clave_aleatoria_de_32_caracteres_o_mas

# Puerto del servidor
PORT=8080